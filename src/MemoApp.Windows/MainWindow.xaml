<Window x:Class="MemoApp.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="메모앱 — 합성 자료용 시험판" Width="1280" Height="850" MinWidth="1000" MinHeight="700">
 <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="ViewRoot" Margin="20" MinWidth="1000" MinHeight="650"><Grid.LayoutTransform><ScaleTransform x:Name="UiScale"/></Grid.LayoutTransform>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#FFF3CD" Padding="12" Margin="0,0,0,12"><StackPanel>
   <Menu><MenuItem Header="_파일"><MenuItem x:Name="StartupMenu" Header="Windows 로그인 시 잠긴 트레이로 실행" IsCheckable="True" IsChecked="False" IsEnabled="False" Click="StartupMenu_Click"/><MenuItem x:Name="TrayMenu" Header="트레이 상주 (이번 실행)" IsCheckable="True" IsChecked="False" Click="TrayMenu_Click"/><MenuItem x:Name="ExitMenu" Header="완전히 종료" Click="Exit_Click"/></MenuItem></Menu>
   <TextBlock Text="합성 자료용 · 서명 없는 개발 시험판입니다. 실제 개인정보를 사용하지 마세요. 실제 IME·OS 잠금·다중모니터 사용자 검증을 기다립니다." TextWrapping="Wrap" Foreground="DarkRed"/>
   <TextBlock Foreground="Black" x:Name="Notice" Text="잠금 — 복구 비밀로 해제하세요." TextWrapping="Wrap" FontWeight="Bold" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <WrapPanel Grid.Row="1" Margin="0,0,0,16">
   <Button x:Name="NewButton" Content="새 메모" Click="NewNote_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="SaveButton" Content="지금 저장" Click="Save_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="LockButton" Content="잠금" Click="Lock_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="WholeTransferButton" Content="전체 자료 이전 파일" Click="WholeTransfer_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="BackupPreviewButton" Content="암호 백업 미리보기" Click="BackupPreview_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="BackupMergeButton" Content="선택 메모의 백업 이력 보존" Click="BackupMerge_Click" ToolTip="현재 메모 유지 · 같은 메모 ID의 백업 이력 보존 · 미저장 수정은 비교 전에 암호 저장" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="PendingBackupBranchesButton" Content="보존된 백업 분기 비교" Click="PendingBackupBranches_Click" ToolTip="선택한 현재 메모의 보존 분기를 읽기 전용 비교 · 미저장 수정은 비교 전에 암호 저장" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="BackupButton" Content="암호 백업" Click="Backup_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="DuplicateButton" Content="복제" Click="Duplicate_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="DeleteButton" Content="휴지통으로" Click="Delete_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="RestoreButton" Content="메모 복원" Click="Restore_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="TxtImportButton" Content="TXT 가져오기" Click="TxtImport_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="MarkdownImportButton" Content="Markdown 원문 가져오기" Click="MarkdownImport_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="ExcelImportButton" Content="Excel 제목·본문 가져오기" Click="ExcelImport_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="PdfExportButton" Content="선택 메모 PDF 내보내기" Click="PdfExport_Click" Padding="6" Margin="0,0,0,4" IsEnabled="False"/>
    <Button x:Name="ExcelExportButton" Content="선택 Excel 내보내기" Click="ExcelExport_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="WordExportButton" Content="선택 Word 내보내기" Click="WordExport_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="TxtExportButton" Content="TXT 내보내기" Click="TxtExport_Click" Padding="12,6" Margin="0,0,8,0" IsEnabled="False"/>
   <Button x:Name="HistoryButton" Content="수정 이력" Click="History_Click" Padding="12,6" IsEnabled="False"/>
   <Button Content="메모 숨김/표시" Click="ToggleSticky_Click" Padding="8" Margin="6,0,0,0"/>
   <Button Content="메모 정렬" Click="ArrangeSticky_Click" Padding="8" Margin="6,0,0,0"/>
   <Button Content="날짜 달력" Click="Calendar_Click" Padding="8" Margin="6,0,0,0"/>
   <Button Content="시계" Click="Clock_Click" Padding="8" Margin="6,0,0,0"/>
   <CheckBox x:Name="DarkToggle" Content="다크" Click="UiPreference_Changed" Margin="8,8,0,0"/>
   <TextBlock Text=" 글자 " VerticalAlignment="Center"/><Slider x:Name="FontSlider" Width="80" Minimum="12" Maximum="36" Value="14" ValueChanged="UiSlider_Changed"/>
   <TextBlock Text=" 배율 " VerticalAlignment="Center"/><Slider x:Name="ScaleSlider" Width="80" Minimum="0.75" Maximum="1.75" Value="1" ValueChanged="UiSlider_Changed"/>
  </WrapPanel>
  <ScrollViewer x:Name="LockPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="650" HorizontalAlignment="Left">
   <TextBlock Text="암호 메모 해제 / 새 시험 자료 생성" FontSize="22" Margin="0,0,0,16"/>
   <TextBlock Text="복구 비밀은 32-byte 난수의 43글자 표기입니다. 재시작·잠금 해제·다른 PC 복구에도 필요합니다. 비밀을 잃으면 복구할 수 없습니다." TextWrapping="Wrap"/>
   <TextBlock Text="DPAPI 자동 접근: 꺼짐·미제공. Hello: 미제공·미검증. 앱/OS 잠금 시 편집 화면을 즉시 숨깁니다." TextWrapping="Wrap" Margin="0,8,0,16"/>
   <TextBlock Text="기존 자료의 복구 비밀"/>
   <PasswordBox x:Name="RecoveryInput" MaxLength="43" Width="550" HorizontalAlignment="Left" Margin="0,4,0,8"/>
   <Button Content="해제" Click="Unlock_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,16"/>
   <Separator/>
   <Button Content="새 자료용 복구 비밀 생성" Click="GenerateSecret_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,16,0,8"/>
   <TextBlock Text="생성한 비밀을 오프라인에 보관한 뒤 아래에 정확히 다시 입력하세요. 자동 클립보드 복사·로그 기록은 하지 않습니다." TextWrapping="Wrap"/>
   <TextBox x:Name="NewSecretDisplay" IsReadOnly="True" IsUndoEnabled="False" Width="550" HorizontalAlignment="Left" Margin="0,8,0,8"/>
   <PasswordBox x:Name="ConfirmationInput" MaxLength="43" Width="550" HorizontalAlignment="Left" Margin="0,0,0,8"/>
   <Button Content="재입력 확인 후 새 자료 만들기" Click="Create_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,16"/>
   <Separator/>
   <TextBlock Text="손상·실패 복구: 기존 파일과 정상 후보를 보존합니다. 후보 검증과 적용은 별도 동작입니다." TextWrapping="Wrap" Margin="0,16,0,8"/>
   <Button Content="위 복구 비밀로 후보 검사" Click="Inspect_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,8"/>
   <ComboBox x:Name="Candidates" DisplayMemberPath="Name" Width="550" HorizontalAlignment="Left" Margin="0,0,0,8"/>
   <Button Content="선택한 후보를 새 snapshot으로 복구" Click="Recover_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,8"/>
   <Button Content="보류 암호문 사본 저장" Click="ExportPending_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,8"/>
   <Button Content="암호문 사본 가져와 후보로 보존" Click="Import_Click" HorizontalAlignment="Left" Padding="12,6"/>
  </StackPanel></ScrollViewer>
  <Grid x:Name="EditingPanel" Grid.Row="2" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0"><StackPanel>
    <TextBlock Text="자동 암호 백업" TextWrapping="Wrap"/><TextBlock x:Name="AutoBackupDirectory" TextWrapping="Wrap"/>
    <ComboBox x:Name="AutoBackupMode" SelectedIndex="0" Margin="0,4,0,4"><ComboBoxItem Content="자동 백업 꺼짐"/><ComboBoxItem Content="저장 후 백업"/><ComboBoxItem Content="UTC 하루 한 번"/></ComboBox>
    <CheckBox x:Name="AutoBackupPersist" Content="재실행 뒤 이 기기에 복원" IsChecked="False"/><CheckBox x:Name="AutoBackupExit" Content="완전 종료 때 백업"/><TextBlock Text="보관 한도 1~100개 (가득 차면 중단)" TextWrapping="Wrap"/><TextBox x:Name="AutoBackupCapacity" Text="20" MaxLength="3"/>
    <Button Content="조건 확인 후 백업 폴더 선택" Click="AutoBackupChoose_Click"/><Button Content="자동 백업 설정 해제" Click="AutoBackupDisable_Click" Margin="0,0,0,12"/>
    <TextBlock Text="암호 백업 후 휴지통 자동 정리 · 기본 꺼짐" TextWrapping="Wrap"/><TextBlock x:Name="AutoTrashDirectory" TextWrapping="Wrap"/>
    <ComboBox x:Name="AutoTrashDays" SelectedIndex="1" Margin="0,4,0,4"><ComboBoxItem Content="7일보다 오래됨"/><ComboBoxItem Content="30일보다 오래됨"/><ComboBoxItem Content="90일보다 오래됨"/></ComboBox>
    <Button Content="정리 조건 확인 후 백업 폴더 선택" Click="AutoTrashChoose_Click"/><Button Content="자동 정리 끄기" Click="AutoTrashDisable_Click" Margin="0,0,0,12"/>
    <TextBlock Text="최근 메모 (기기별 최대 20개)"/><ComboBox x:Name="RecentNotesList" DisplayMemberPath="Name" Margin="0,4,0,4"/>
    <WrapPanel><Button Content="최근 메모 열기" Click="RecentOpen_Click"/><Button Content="목록 지우기" Click="RecentClear_Click"/></WrapPanel>
    <TextBlock Text="저장 검색 (기기별 최대 20개)" Margin="0,12,0,0"/><ComboBox x:Name="SavedSearchList" DisplayMemberPath="Name" Margin="0,4,0,4"/>
    <TextBox x:Name="SavedSearchName" MaxLength="64" ToolTip="저장 검색 이름" Margin="0,0,0,4"/>
    <Button Content="현재 조건 저장 / 같은 이름 갱신" Click="SaveSearch_Click"/>
    <WrapPanel><Button Content="선택 조건 적용" Click="ApplySearch_Click"/><Button Content="선택 조건 삭제" Click="DeleteSearch_Click"/></WrapPanel>
    <Button x:Name="ResetSearchButton" Content="검색 초기화" Click="ResetSearch_Click" Margin="0,4,0,12"/>
    <TextBlock Text="분류" FontSize="18" Margin="0,0,0,8"/>
    <ComboBox x:Name="ViewFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,0,8">
     <ComboBoxItem Content="전체 활성 메모"/><ComboBoxItem Content="즐겨찾기"/><ComboBoxItem Content="중요 메모"/><ComboBoxItem Content="보관함"/><ComboBoxItem Content="휴지통"/><ComboBoxItem Content="미분류"/>
    </ComboBox>
    <TextBlock Text="폴더 (하위 포함)"/><ComboBox x:Name="FolderFilter" DisplayMemberPath="Name" SelectionChanged="Filter_Changed" Margin="0,4,0,12"/>
    <TextBox x:Name="FolderName" MaxLength="128" ToolTip="새 폴더 이름" Margin="0,0,0,4"/>
    <Button Content="선택 폴더 아래 만들기" Click="CreateFolder_Click" Padding="6" Margin="0,0,0,16"/>
    <TextBlock Text="태그로 검색"/><TextBox x:Name="TagFilter" TextChanged="SearchText_Changed" Margin="0,4,0,12"/>
    <TextBlock Text="수정일 범위 (포함)"/><DatePicker x:Name="FromDate" SelectedDateChanged="Filter_Changed" Margin="0,4,0,4"/><DatePicker x:Name="UntilDate" SelectedDateChanged="Filter_Changed" Margin="0,0,0,12"/>
    <TextBlock Text="정렬"/><ComboBox x:Name="SortFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,4,0,12"><ComboBoxItem Content="최근 수정순"/><ComboBoxItem Content="작성일순"/><ComboBoxItem Content="이름순"/><ComboBoxItem Content="사용자 순서"/></ComboBox>
    <TextBlock x:Name="Counts" TextWrapping="Wrap" Foreground="Gray"/>
    <TextBlock Text="휴지통은 내용을 암호화해 보존합니다. 자동 비우기·영구삭제는 제공하지 않습니다." TextWrapping="Wrap" Foreground="Gray" Margin="0,12,0,0"/>
    <TextBlock Text="Ctrl/Shift로 여러 메모 선택" TextWrapping="Wrap" Margin="0,12,0,4"/>
    <ComboBox x:Name="BatchFolder" DisplayMemberPath="Name" Margin="0,0,0,4"/>
    <Button x:Name="BatchMoveButton" Content="선택 메모 일괄 이동" Click="BatchMove_Click" Padding="6" Margin="0,0,0,4" IsEnabled="False"/>
    <Button x:Name="BatchDeleteButton" Content="선택 메모 일괄 휴지통" Click="BatchDelete_Click" Padding="6" Margin="0,0,0,4" IsEnabled="False"/>
    <Button x:Name="BatchRestoreButton" Content="선택 메모 일괄 복원" Click="BatchRestore_Click" Padding="6" IsEnabled="False"/>
    <Button x:Name="BatchTxtExportButton" Content="선택 메모 TXT 내보내기" Click="BatchTxtExport_Click" Padding="6" Margin="0,4,0,0" IsEnabled="False"/>
   </StackPanel></ScrollViewer>
   <DockPanel Grid.Column="1" Margin="0,0,16,0">
    <StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="순서 ↑" Click="OrderUp_Click" Padding="6" Margin="0,0,6,4"/><Button Content="순서 ↓" Click="OrderDown_Click" Padding="6" Margin="0,0,0,4"/></WrapPanel><TextBlock Text="검색"/><TextBox x:Name="SearchInput" TextChanged="SearchText_Changed" MaxLength="256" Margin="0,4,0,4"/><ComboBox x:Name="SearchFieldFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,0,8"><ComboBoxItem Content="제목 + 본문 + 첨부 이름"/><ComboBoxItem Content="제목"/><ComboBoxItem Content="본문"/><ComboBoxItem Content="첨부 이름·확장자"/></ComboBox>
     <Border x:Name="SearchMatchArea" Visibility="Collapsed" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8"><StackPanel>
      <TextBlock x:Name="SearchMatchSource" Foreground="Gray" Margin="0,0,0,4"/>
      <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SearchMatchPreview" TextWrapping="Wrap" Visibility="Collapsed"><Run x:Name="SearchMatchBefore"/><Run x:Name="SearchMatch" FontWeight="Bold" Background="#FFE69A" Foreground="Black"/><Run x:Name="SearchMatchAfter"/></TextBlock></ScrollViewer>
     </StackPanel></Border></StackPanel>
    <ListBox x:Name="NotesList" SelectionMode="Extended" SelectionChanged="NotesList_SelectionChanged" AllowDrop="True" PreviewMouseLeftButtonDown="NoteDragStart" PreviewMouseMove="NoteDragMove" DragOver="NoteDragOver" Drop="NoteDrop">
     <ListBox.ItemTemplate><DataTemplate><Border Padding="8"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" Foreground="Gray"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <DockPanel x:Name="Editor" Grid.Column="2" IsEnabled="False">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="문서 모드 · 100개(휴지통 포함) · 제목 256자/본문 65,536자 · 파일 16 MiB. 약 0.7초마다 암호 저장." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <WrapPanel Margin="0,0,0,8"><Button Content="포스트잇 열기" Click="OpenSticky_Click" Padding="6" Margin="0,0,8,0"/><CheckBox Content="중요" IsChecked="{Binding Important}" Margin="0,4,8,0"/><CheckBox Content="즐겨찾기" IsChecked="{Binding Favorite}" Margin="0,4,8,0"/><CheckBox Content="목록 고정" IsChecked="{Binding Pinned}" Margin="0,4,8,0"/><CheckBox Content="보관" IsChecked="{Binding Archived}" Margin="0,4,8,0"/></WrapPanel>
     <WrapPanel Margin="0,0,0,8"><TextBlock Text="폴더 " VerticalAlignment="Center"/><ComboBox x:Name="MoveFolder" Width="180" DisplayMemberPath="Name" SelectionChanged="MoveFolder_Changed" Margin="0,0,8,0"/><TextBlock Text="색 " VerticalAlignment="Center"/><ComboBox x:Name="ColorPicker" Width="100" SelectionChanged="Color_Changed"><ComboBoxItem Content="노랑" Tag="yellow"/><ComboBoxItem Content="파랑" Tag="blue"/><ComboBoxItem Content="초록" Tag="green"/><ComboBoxItem Content="분홍" Tag="pink"/><ComboBoxItem Content="흰색" Tag="white"/><ComboBoxItem Content="보라" Tag="purple"/></ComboBox></WrapPanel>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="태그 적용" Click="ApplyTags_Click" Padding="6"/><TextBox x:Name="TagsInput" MaxLength="2048" ToolTip="쉼표로 구분한 태그 (메모당 최대 16개)"/></DockPanel>
     <TextBlock Text="제목"/><TextBox x:Name="TitleEditor" MaxLength="256" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="6"/>
     <TextBlock x:Name="NoteInfo" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <ContentControl x:Name="AttachmentHost" Visibility="Collapsed" Margin="0,0,0,8"/>
     <WrapPanel><TextBlock Text="문서 모드 " VerticalAlignment="Center"/><ComboBox x:Name="ModeChoice" Width="180" SelectionChanged="Mode_Changed"><ComboBoxItem Content="일반 텍스트" Tag="plain"/><ComboBoxItem Content="서식 문서" Tag="rich"/><ComboBoxItem Content="Markdown 원문" Tag="markdown"/></ComboBox></WrapPanel>
     <TextBlock Text="Ctrl+Z 실행취소 / Ctrl+Y 다시실행 · 모드 전환은 원본을 이력에 보존합니다" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid x:Name="BodyPanel"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="BodyEditor" MaxLength="65536" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" IsUndoEnabled="True" UndoLimit="100"/>
    <ContentControl x:Name="StructuredHost" Grid.RowSpan="2" Visibility="Collapsed"/><ContentControl x:Name="MarkdownHost" Grid.Row="1" MaxHeight="280" MinHeight="80" Margin="0,8,0,0" Visibility="Collapsed"/>
    </Grid>
   </DockPanel>
  </Grid>
 </Grid></ScrollViewer>
</Window>
