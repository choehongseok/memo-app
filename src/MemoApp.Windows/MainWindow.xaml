<Window x:Class="MemoApp.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="메모앱 — 개발 중" Width="1000" Height="650">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#FFF3CD" Padding="12" Margin="0,0,0,16">
   <TextBlock x:Name="Notice" Text="암호화 저장 독립 검토 대기 중입니다. 실제 메모 작성·저장 기능은 아직 사용할 수 없습니다." TextWrapping="Wrap"/>
  </Border>
  <TextBlock x:Name="Pending" Grid.Row="1" Text="첫 안전한 메모 흐름을 개발하고 있습니다." FontSize="20"/>
  <Grid x:Name="PreviewPanel" Grid.Row="1" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,16,0"><TextBlock Text="분류" FontSize="18" Margin="0,0,0,12"/><TextBlock Text="임시 편집 세션"/></StackPanel>
   <DockPanel Grid.Column="1" Margin="0,0,16,0">
    <Button DockPanel.Dock="Top" Content="새 임시 메모" Click="NewNote_Click" Padding="8" Margin="0,0,0,8"/>
    <ListBox x:Name="NotesList" SelectionChanged="NotesList_SelectionChanged">
     <ListBox.ItemTemplate><DataTemplate><Border Padding="8"><StackPanel><TextBlock Text="임시 메모" Foreground="Gray"/><TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding ModifiedAt, StringFormat={}{0:HH:mm:ss}}" Foreground="Gray"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <DockPanel x:Name="Editor" Grid.Column="2" IsEnabled="False">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="저장 기능 미연결 · 종료하면 모든 임시 메모가 사라집니다." Foreground="DarkRed" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Button Content="이 메모를 포스트잇으로 열기" Click="OpenSticky_Click" HorizontalAlignment="Left" Padding="8" Margin="0,0,0,12"/>
     <TextBlock Text="제목"/><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6"/>
     <TextBlock Text="일반 텍스트 본문"/>
    </StackPanel>
    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
   </DockPanel>
  </Grid>
 </Grid>
</Window>
