<Window x:Class="MemoApp.Windows.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="수정 이력 — 합성 자료용" Width="850" Height="650" MinWidth="600" MinHeight="400">
 <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Margin="0,0,12,0"><TextBlock DockPanel.Dock="Top" Text="저장된 과거 리비전 (UTC)" Margin="0,0,0,8"/><ListBox x:Name="Revisions" SelectionChanged="Selection_Changed"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Metadata.Deleted, StringFormat=삭제 사건: {0}}" Foreground="Gray"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
  <DockPanel Grid.Column="1"><StackPanel DockPanel.Dock="Top"><TextBlock Text="과거 내용을 읽기 전용으로 표시합니다. 복원은 현재 상태를 이력에 남기는 새 리비전입니다." TextWrapping="Wrap" Margin="0,0,0,8"/><Button x:Name="RestoreVersion" Content="선택 버전으로 새 리비전 만들기" Click="Restore_Click" Padding="8" Margin="0,0,0,8"/><TextBox x:Name="PastTitle" IsReadOnly="True" IsUndoEnabled="False" Margin="0,0,0,8"/></StackPanel><TextBox x:Name="PastText" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></DockPanel>
 </Grid>
</Window>
