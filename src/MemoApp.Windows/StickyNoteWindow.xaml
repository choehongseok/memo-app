<Window x:Class="MemoApp.Windows.StickyNoteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MemoApp.Windows" Title="포스트잇 · 닫기는 숨김 (삭제 아님)" Width="360" Height="400" MinWidth="300" MinHeight="160" Background="#FFF7BA">
 <DockPanel Margin="10"><DockPanel.LayoutTransform><ScaleTransform x:Name="ContentScale"/></DockPanel.LayoutTransform>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
   <TextBlock x:Name="SaveState" Text="저장 상태 준비" TextWrapping="Wrap" AutomationProperties.Name="암호 저장 상태" AutomationProperties.LiveSetting="Polite" ToolTip="공유 암호 자료 전체의 저장 상태 · 합성 자료만 사용"/>
   <TextBlock x:Name="ActionState" TextWrapping="Wrap" Foreground="DarkRed"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Top" ClipToBounds="True">
   <DockPanel Margin="0,0,0,6">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="NewStickyButton" Content="＋" Tag="Icon" Click="NewSticky_Click" ToolTip="새 포스트잇에서 바로 작성" AutomationProperties.Name="새 포스트잇" Padding="5,2"/>
     <CheckBox x:Name="ImportantToggle" Content="★" Tag="Icon" IsChecked="{Binding Important}" ToolTip="중요 메모" AutomationProperties.Name="중요 메모" VerticalAlignment="Center" Margin="6,0"/>
     <CheckBox x:Name="TopmostToggle" Content="↑" Tag="Icon" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="항상 위 (다른 창보다 앞에 표시)" AutomationProperties.Name="항상 위" VerticalAlignment="Center" Margin="0,0,6,0"/>
    </StackPanel>
    <TextBlock Text="메모" VerticalAlignment="Center" Foreground="Gray"/>
   </DockPanel>
   <TextBox x:Name="TitleEditor" MaxLength="256" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="메모 제목" AutomationProperties.Name="메모 제목" BorderThickness="0" FontWeight="Bold" Padding="3,4" Margin="0,0,0,6"/>
   <Expander x:Name="MoreTools" Header="⋯ 더보기" IsExpanded="False" ToolTip="접기 · 위치 고정 · 투명도" AutomationProperties.Name="포스트잇 더보기" Margin="0,0,0,4"><WrapPanel>
    <CheckBox x:Name="FoldToggle" Content="본문 접기" Checked="Fold_Changed" Unchecked="Fold_Changed" Margin="0,4,8,4"/>
    <CheckBox x:Name="PositionToggle" Content="위치 고정" ToolTip="창의 위치·크기 변경 방지 (항상 위와 별개)" Checked="Position_Changed" Unchecked="Position_Changed" Margin="0,4,8,4"/>
    <TextBlock Text="투명도" VerticalAlignment="Center"/><Slider AutomationProperties.Name="포스트잇 투명도" Width="90" Minimum="0.3" Maximum="1" Value="{Binding Opacity, RelativeSource={RelativeSource AncestorType=Window}}"/>
   </WrapPanel></Expander>
   <Expander x:Name="AttachmentTools" Header="첨부 · 이미지 · OCR" IsExpanded="False" Margin="0,0,0,4"><ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><ContentControl x:Name="AttachmentHost" Visibility="Collapsed"/></ScrollViewer></Expander>
  </StackPanel>
  <Grid x:Name="BodyPanel"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBox x:Name="BodyEditor" BorderThickness="0" MaxLength="65536" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6" AutomationProperties.Name="메모 본문"/>
   <local:RichImageNativeContentControl x:Name="StructuredHost" Grid.RowSpan="2" Visibility="Collapsed"/><ContentControl x:Name="MarkdownHost" Grid.Row="1" MaxHeight="180" MinHeight="60" Margin="0,6,0,0" Visibility="Collapsed"/>
  </Grid>
 </DockPanel>
</Window>
